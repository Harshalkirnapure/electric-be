# ─────────────── Server ───────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# ─────────────── Database ───────────────
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/electrical_store
# MongoDB Atlas (replace with your own SRV string):
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/electrical_store
# Optional: use an in-memory MongoDB for local dev without installing MongoDB:
# MONGODB_MEMORY=true

# ─────────────── Auth ───────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_DOMAIN=
# "auto" -> Secure only in production
COOKIE_SECURE=auto

# ─────────────── Admin bootstrap ───────────────
# Used by `npm run seed` to create the first owner/admin account.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Store Owner

# ─────────────── Store / delivery ───────────────
STORE_NAME=VoltCart Electricals
STORE_PHONE=+91 90000 00000
STORE_WHATSAPP=919000000000
STORE_ADDRESS_LINE=Shop No. 1, Main Market Road
STORE_CITY=Your City
STORE_STATE=Your State
STORE_PINCODE=000000
STORE_LAT=
STORE_LNG=
DELIVERY_RADIUS_KM=60
# Local delivery charge in rupees (flat). 0 = free delivery.
LOCAL_DELIVERY_CHARGE=49
# Free local delivery when order subtotal (INR) is >= this amount. 0 disables.
FREE_DELIVERY_ABOVE=999
# Comma separated allowed PIN codes (optional extra restriction, empty = radius only)
ALLOWED_PIN_CODES=
# Enable Cash on Delivery only when your delivery process supports it.
COD_ENABLED=false
# Maximum order total (INR) allowed for a Cash on Delivery order.
COD_MAX_AMOUNT=50000

# ─────────────── Payments (Razorpay test mode) ───────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_REFUND_ENABLED=true

# ─────────────── Cloudinary (image storage) ───────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─────────────── Logging ───────────────
LOG_LEVEL=info
